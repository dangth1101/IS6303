# Local development only. Copy to .env before starting the database:
#
#   cp .env.example .env
#
# .env is gitignored; this file is the committed template.

# Role and database created on first start.
POSTGRES_USER=recipes
POSTGRES_DB=recipes

# Required. Any value works locally; compose refuses to start if it is empty.
POSTGRES_PASSWORD=

# Host port the database is published on. Change this if something else on the
# machine already owns 5432.
POSTGRES_PORT=5432

# Connection string built from the values above, for psql / a GUI / Python:
#   postgresql://recipes:<POSTGRES_PASSWORD>@localhost:5432/recipes
